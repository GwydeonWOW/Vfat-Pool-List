AUTH_USER=admin
AUTH_PASS=replace-with-a-long-random-password
PORT=3000
NODE_ENV=production
# Required only to enable Uniswap. Override the URL if your Uniswap data plan
# exposes a different pools endpoint returning { pools: [...] }.
UNISWAP_API_KEY=
UNISWAP_API_URL=https://interface.gateway.uniswap.org/v2/pools
# Optional override if Cetus changes or proxies its public endpoint.
CETUS_API_URL=https://api-sui.cetus.zone/v2/sui/pools_info
